{
  "name": "@hey-amanthakur/lock-box",
  "version": "1.0.1",
  "description": "Lock-Box — a production-grade distributed mutex and lease library for Node.js. Zero runtime dependencies. Pluggable backends (in-memory, Redis), blocking acquire, TTL leases, auto-renewal, AbortSignal cancellation and framework adapters.",
  "license": "MIT",
  "author": "Aman Thakur <https://github.com/hey-amanthakur>",
  "homepage": "https://github.com/hey-amanthakur/lock-box#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/hey-amanthakur/lock-box.git"
  },
  "bugs": {
    "url": "https://github.com/hey-amanthakur/lock-box/issues"
  },
  "keywords": [
    "lock",
    "mutex",
    "distributed-lock",
    "distributed-mutex",
    "redis-lock",
    "lease",
    "redlock",
    "critical-section",
    "coordination",
    "concurrency",
    "idempotent",
    "nodejs",
    "zero-dependency"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./redis": {
      "types": "./dist/redis.d.ts",
      "import": "./dist/redis.js",
      "require": "./dist/redis.cjs"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js",
      "require": "./dist/express.cjs"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "import": "./dist/fastify.js",
      "require": "./dist/fastify.cjs"
    },
    "./koa": {
      "types": "./dist/koa.d.ts",
      "import": "./dist/koa.js",
      "require": "./dist/koa.cjs"
    },
    "./nestjs": {
      "types": "./dist/nestjs.d.ts",
      "import": "./dist/nestjs.js",
      "require": "./dist/nestjs.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "tsx --test test/**/*.test.ts",
    "test:run": "node --import tsx --test test/*.test.ts",
    "test:coverage": "c8 --check-coverage --lines 90 --functions 90 --branches 85 --statements 90 npm run test:run",
    "test:coverage:report": "c8 --reporter html --reporter text npm run test:run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "prepublishOnly": "npm run verify",
    "clean": "rm -rf dist coverage"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/koa": "^3.0.3",
    "@types/node": "^22.0.0",
    "c8": "^10.1.3",
    "eslint": "^9.39.5",
    "express": "^5.1.0",
    "fastify": "^5.11.2",
    "ioredis": "^5.4.0",
    "ioredis-mock": "^8.9.0",
    "koa": "^3.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.66.0"
  },
  "peerDependencies": {
    "@nestjs/common": ">=9",
    "@nestjs/core": ">=9",
    "express": ">=4",
    "fastify": ">=4",
    "ioredis": ">=5",
    "koa": ">=2",
    "reflect-metadata": ">=0.1.13",
    "rxjs": ">=7"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "koa": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "c8": {
    "reporter": [
      "text",
      "text-summary",
      "lcov"
    ],
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "dist/**",
      "test/**",
      "examples/**",
      "**/*.d.ts",
      "src/index.ts"
    ],
    "all": true
  }
}
